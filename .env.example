# Copy to .env (gitignored). run_cluster.sh loads it into the SuperLink and every SuperNode.
# Nebius Token Factory; the Kimi key works for both Kimi and MiniMax models.
KIMI_API_KEY=
MINIMAX_API_KEY=
# Optional overrides (run_cluster.sh defaults: Nebius endpoint, FLWR_MODEL_API_KEY=$KIMI_API_KEY)
# FLWR_MODEL_API_ENDPOINT=https://api.tokenfactory.tf-ca1.nebius.com/v1/responses
# FLWR_MODEL_API_KEY=
